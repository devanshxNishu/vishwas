# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS/editor
.DS_Store
.idea/
.vscode/

# Logs and temporary files
*.log
tmp/
temp/

# ...but ablations/ and logs/ hold RESULTS, not build noise. ablations/*.log is
# the printed output of each ablation variant and is cited as a source in
# CLAUDE.md, docs/DECK-VERIFICATION.md and docs/CONSISTENCY-AUDIT.md;
# logs/*.log is the only record of how the five-year numbers were produced.
# Blanket *.log had been excluding all of them silently.
# These negations work only because neither parent directory is itself
# excluded -- `git check-ignore -v logs ablations` exits 1. A negation under a
# directory excluded as `dir/` is never reached at all, because git stops at the
# directory and never looks inside it. models/ used to be excluded that way; it
# is now excluded per-entry, as `models/*`, precisely so that the negation on it
# below is reachable.
!ablations/*.log
!logs/*.log

# One per cycle, ~570 KB each, regenerated by src/20_operational.py on demand.
# The parquet beside it is already covered by data/*.parquet. Small analysis
# results like data/domain_check.csv are NOT matched here and stay tracked.
data/operational_*.json

# Bundles are a COPY of the history, never part of it. Kept ignored so one can
# sit in the repo folder for transfer without ever being committed.
*.bundle

# Generated weather data and model artifacts
data/*.parquet
data/features_parts/
data/imd_cache/
data/raw/*
!data/raw/manifest.jsonl

# Large generated outputs
outputs/
checkpoints/

# models/ is excluded PER-ENTRY rather than as `models/`, so that the negation
# below is reachable -- see the note above. The fitted models are the artefact
# this project exists to produce, and they are small: ~600 KB for all three
# against 3.4 GB of data/, which stays ignored. Without them a fresh clone has
# the code but no way to produce a model except re-running a 50 GB fetch, so
# the API, the dashboard export and the operational scorer are all dead on
# arrival. Tracking them is what makes a clone useful to somebody else.
# Written as a negation, not `git add -f`, so the NEXT model is tracked
# automatically instead of depending on somebody remembering the flag.
# Everything else in models/ stays ignored, subdirectories included.
models/*
!models/*.joblib
*.grib
*.grib2
*.idx
*.nc
*.npy
*.npz


# Scratch folder of session outputs: drafts, duplicates and superseded copies.
# Deliberately NOT tracked. It holds LATER but UNRENDERED variants of the deck
# figure generators (deck_fig*.py, 5 Sep 04:05) whose canonical, committed
# versions live in src/deck_figures/ (5 Sep 03:58). The shipped deck assets in
# deck/assets/ are 03:58 and therefore came from the COMMITTED generators.
# If you are looking for the generator for a deck figure, it is in
# src/deck_figures/ and nowhere else.
Claude outputs/
